# ── 对象存储：兼容 S3 协议（阿里云 OSS / MinIO 等） ──
AION_S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
AION_S3_ACCESS_KEY=YOUR_ACCESS_KEY
AION_S3_SECRET_KEY=YOUR_SECRET_KEY
AION_S3_REGION=oss-cn-beijing
AION_S3_DOCUMENTS_BUCKET=aion-knowledge-dev
AION_S3_PREFIX=docs
# virtual（阿里云 OSS）或 path（MinIO）
AION_S3_ADDRESSING_STYLE=virtual

# ── Embedding：Ollama（bge-m3 双编码器，用于向量检索 + 多样性相似度）──
AION_EMBEDDING_PROVIDER=ollama
AION_EMBEDDING_BASE_URL=http://localhost:11434
AION_EMBEDDING_MODEL=bge-m3
AION_EMBEDDING_DIMENSIONS=1024

# ── 数据库 ──
# 格式：postgresql+asyncpg://user:password@host:port/dbname
AION_DB_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/aion_knowledge

# ── 数据库迁移：启动时自动按 ORM 更新 schema ──
AION_DB_AUTO_MIGRATE=true

# ── Reranker：独立服务（bge-reranker-base ONNX，端口 12111）──
AION_RERANKER_ENABLED=true
AION_RERANKER_ENDPOINT=http://localhost:12111/rerank
AION_RERANKER_MAX_TOKENS=512
# 单批大小
AION_RERANKER_MAX_BATCH=8
# 最大并发批次数
AION_RERANKER_MAX_CONCURRENCY=4

# ── LLM：阿里云 MaaS（OpenAI 兼容接口） ──
AION_LLM_PROVIDER=alicloud
AION_LLM_MODEL=qwen3.7-max-2026-05-20
AION_LLM_API_KEY=YOUR_API_KEY
AION_LLM_BASE_URL=https://llm-xed3egoyxs1m9yby.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AION_LLM_REQUEST_TIMEOUT=180
AION_LLM_ENABLE_THINKING=true
AION_LLM_THINKING_BUDGET=32000
AION_LLM_MAX_COMPLETION_TOKENS=64000

# ── VLM 多模态模型（图片描述专用，独立于上面的文字 LLM） ──
AION_VLM_PROVIDER=alicloud
AION_VLM_MODEL=qwen3-vl-plus
AION_VLM_API_KEY=YOUR_API_KEY
AION_VLM_BASE_URL=https://llm-xed3egoyxs1m9yby.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AION_VLM_REQUEST_TIMEOUT=300

# ── Neo4j 图数据库 ──
AION_NEO4J_URI=neo4j://localhost:7687
AION_NEO4J_USER=neo4j
AION_NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
AION_NEO4J_ENABLED=true

# ── 开发模式：仅执行到 chunker ──
AION_INDEX_ONLY=false

# ── 逻辑删除 ──
# true（默认）= 仅置标记保留数据；false = 异步真实删除
AION_DELETION_LOGICAL=true

# ── 后处理模块（vlm_caption 为 always_on 模块，无需配置） ──
AION_POSTPROC_KEYWORD_EXTRACT=true
AION_POSTPROC_QUESTION_GEN=true
AION_POSTPROC_SUMMARIZER=true
AION_POSTPROC_RAPTOR=true
AION_POSTPROC_GRAPH_EXTRACT=true
AION_POSTPROC_DISAMBIGUATION=true
AION_POSTPROC_COMMUNITY=true
AION_POSTPROC_WIKI=true

# ── 查询改写（默认启用，需 LLM 可用） ──
AION_QUERY_REWRITE_ENABLED=true

# ── 文档解析（调参，默认值已合理可不配）──
AION_PDF_RENDER_DPI=200
AION_PDF_RENDER_MAX_WORKERS=1
AION_PDF_JPEG_QUALITY=85
AION_PDF_FORCE_SCANNED=false
AION_MARKITDOWN_MAX_WORKERS=1
AION_ODL_MAX_WORKERS=1

# ── 检索 ──
AION_RETRIEVAL_PATH_TIMEOUT=30.0

# ── FAQ 检索调参 ──
AION_FAQ_SCORE_BOOST=1.2
AION_FAQ_DIRECT_ANSWER_THRESHOLD=0.85

# ── 日志 ──
AION_LOG_LEVEL=INFO
